<section class="container fade-up">
  <div class="section-card" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap:20px;">
    <div>
      <h2 class="section-title">Contact TorqueLab</h2>
      <p class="section-subtitle">Need help with fitment, installation, or warranty? Our workshop team is here.</p>
      <p class="section-subtitle">Support hours: Mon–Fri, 9am–6pm EST</p>
      <div class="badge">Call: (555) 123-4567</div>
      <div class="badge">Email: support@torquelabparts.com</div>
      <div style="background:url({{ 'workshop-detail.jpg' | asset_url }}) center/cover no-repeat; border-radius:12px; min-height:200px; margin-top:14px;"></div>
    </div>
    <div>
      {% form 'contact' %}
        <div class="grid" style="grid-template-columns:1fr 1fr; gap:12px;">
          <input type="text" name="contact[name]" placeholder="Name" required style="padding:12px; border-radius:10px; border:1px solid var(--border); background:#0f1116; color:#fff;">
          <input type="email" name="contact[email]" placeholder="Email" required style="padding:12px; border-radius:10px; border:1px solid var(--border); background:#0f1116; color:#fff;">
        </div>
        <input type="text" name="contact[subject]" placeholder="Vehicle / Order details" style="width:100%; margin-top:12px; padding:12px; border-radius:10px; border:1px solid var(--border); background:#0f1116; color:#fff;">
        <textarea name="contact[body]" rows="4" placeholder="How can we help?" style="width:100%; margin-top:12px; padding:12px; border-radius:10px; border:1px solid var(--border); background:#0f1116; color:#fff;"></textarea>
        <button class="btn" type="submit" style="margin-top:12px;">Send message</button>
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Contact form",
  "settings": []
}
{% endschema %}
