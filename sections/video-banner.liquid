<section class="container fade-up">
  <div class="section-card" style="position:relative; overflow:hidden;">
    <div style="position:relative; padding-top:46%; border-radius:12px; overflow:hidden; background:#0f1116;">
      <video autoplay muted loop playsinline style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;">
        <source src="{{ 'workshop-video.mp4' | asset_url }}" type="video/mp4">
      </video>
    </div>
    <div style="margin-top:16px;">
      <h2 class="section-title">Inside the TorqueLab Workshop</h2>
      <p class="section-subtitle">Equipment, testing bays, and build space dedicated to vetting the parts we sell.</p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Video banner",
  "settings": []
}
{% endschema %}
