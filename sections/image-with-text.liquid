<section class="container fade-up">
  <div class="section-card" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px,1fr)); gap:24px; align-items:center;">
    <div>
      <h2 class="section-title">Real Workshop Roots</h2>
      <p class="section-subtitle">TorqueLab Parts blends hands-on garage experience with an obsessive catalog so you spend less time hunting and more time wrenching.</p>
      <div class="bullets">
        <span class="badge">Tech-reviewed fitment notes</span>
        <span class="badge">Performance and OEM options</span>
        <span class="badge">Phone & chat support</span>
      </div>
    </div>
    <div style="background:url({{ 'workshop-hero.jpg' | asset_url }}) center/cover no-repeat; border-radius:12px; min-height:260px;"></div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "settings": []
}
{% endschema %}
