<section class="container fade-up">
  <div class="promo-banners">
    {% assign promos = section.blocks %}
    {% for block in promos %}
      <div class="promo-banner">
        <div>
          <h3>{{ block.settings.title }}</h3>
          <p class="section-subtitle">{{ block.settings.text }}</p>
          <a class="btn" href="{{ block.settings.link }}">{{ block.settings.cta }}</a>
        </div>
        <div style="height:160px; border-radius:12px; background:url({{ block.settings.image | default: 'banner-brakes.jpg' | asset_url }}) center/cover no-repeat;"></div>
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Promo banners",
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {"type":"text","id":"title","label":"Title","default":"Brake System Essentials"},
        {"type":"text","id":"text","label":"Text","default":"Dialed-in brake kits, pads, rotors, and fluid."},
        {"type":"url","id":"link","label":"Link"},
        {"type":"text","id":"cta","label":"Button","default":"Shop now"},
        {"type":"image_picker","id":"image","label":"Image"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {"name":"Promo banners","blocks":[{"type":"banner"},{"type":"banner"},{"type":"banner"}]}
  ]
}
{% endschema %}
