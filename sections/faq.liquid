<section class="container fade-up">
  <div class="section-card">
    <h2 class="section-title">Frequently Asked Questions</h2>
    <div>
      {% for block in section.blocks %}
        <details class="faq-item">
          <summary>{{ block.settings.question }}</summary>
          <div class="section-subtitle">{{ block.settings.answer }}</div>
        </details>
      {% else %}
        <details class="faq-item"><summary>How do I confirm fitment?</summary><div class="section-subtitle">Use Shop by Vehicle and check our fitment notes before checkout.</div></details>
        <details class="faq-item"><summary>How fast is shipping?</summary><div class="section-subtitle">Most stocked items ship within 1–3 business days from US warehouses.</div></details>
        <details class="faq-item"><summary>What if I need to return?</summary><div class="section-subtitle">Hassle-free returns on new items within 30 days. Contact support to start.</div></details>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "blocks": [
    {"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question"},{"type":"textarea","id":"answer","label":"Answer"}]}
  ],
  "presets": [{"name":"FAQ","blocks":[{"type":"faq"},{"type":"faq"},{"type":"faq"}]}]
}
{% endschema %}
