<section class="container fade-up">
  <div class="section-card">
    <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
      <div>
        <h2 class="section-title">Featured products</h2>
        <p class="section-subtitle">Top picks from our techs. Ready for fast install and immediate gains.</p>
      </div>
      <a class="btn secondary" href="/collections/all">Browse all</a>
    </div>
    <div class="grid grid-4">
      {% if section.settings.collection != blank %}
        {% for product in collections[section.settings.collection].products limit: 8 %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          {% render 'product-card' %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ]
}
{% endschema %}
