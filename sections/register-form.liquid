<section class="container fade-up">
  <div class="section-card" style="max-width:520px; margin:0 auto;">
    <h1 class="section-title">Create account</h1>
    {% form 'create_customer' %}
      <input type="text" name="customer[first_name]" placeholder="First name" style="width:100%; padding:12px; border-radius:10px; border:1px solid var(--border); background:#0f1116; color:#fff; margin-bottom:12px;">
      <input type="text" name="customer[last_name]" placeholder="Last name" style="width:100%; padding:12px; border-radius:10px; border:1px solid var(--border); background:#0f1116; color:#fff; margin-bottom:12px;">
      <input type="email" name="customer[email]" placeholder="Email" required style="width:100%; padding:12px; border-radius:10px; border:1px solid var(--border); background:#0f1116; color:#fff; margin-bottom:12px;">
      <input type="password" name="customer[password]" placeholder="Password" required style="width:100%; padding:12px; border-radius:10px; border:1px solid var(--border); background:#0f1116; color:#fff; margin-bottom:12px;">
      <button class="btn" type="submit">Create</button>
    {% endform %}
    <p class="section-subtitle">Already have an account? <a href="/account/login">Sign in</a></p>
  </div>
</section>
{% schema %}
{
  "name": "Register form",
  "settings": []
}
{% endschema %}
