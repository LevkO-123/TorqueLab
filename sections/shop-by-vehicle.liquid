<section id="shop-by-vehicle" class="container fade-up">
  <div class="section-card shop-by-vehicle">
    <div>
      <h2 class="section-title">Shop by Vehicle</h2>
      <p class="section-subtitle">Dial in exact-fit parts using Year / Make / Model. Built for enthusiasts and techs alike.</p>
    </div>
    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(160px,1fr));">
      <select><option>Year</option><option>2024</option><option>2023</option><option>2022</option></select>
      <select><option>Make</option><option>Ford</option><option>Chevrolet</option><option>Subaru</option></select>
      <select><option>Model</option><option>Mustang GT</option><option>Silverado 1500</option><option>WRX</option></select>
      <button class="btn">Find Parts</button>
    </div>
    <p class="section-subtitle">Fitment-first selections curated by technicians so you get parts that work the first time.</p>
  </div>
</section>
{% schema %}
{
  "name": "Shop by vehicle",
  "settings": []
}
{% endschema %}
